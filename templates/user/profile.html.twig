{% extends 'layout/layout.html.twig' %}

{% block title %} Perfil {% endblock %}

{% block javascripts %} 
    {{ parent() }}
    <script src='{{ asset('js/custom/buttons-following.js') }}'></script>
    <script src='{{ asset('js/custom/profile.js') }}'></script>
{% endblock %}



{% block content %}


<div class="profile-box card shadow col-lg-10 mb-5">

    <div class="profile-avatar">
        {% if user.image is not null and user.image is not empty %}
            <img src="/uploads/users/{{ user.image }}" alt="Avatar de {{ user.name|default(user.email) }}">
        {% else %}
            <img class="default" src="/uploads/users/default-avatar.jpg" alt="Avatar por defecto">
        {% endif %}
    </div>

    

    <div class="name-surname">
    {% if app.user.id != user.id %}

        <div class="pull-right buttons-following mt-2">

            {% if user | is_following(app.user) == true %}
                <button class="btn btn-primary pe-none">
                    Te sigue
                </button>
            {% else %}
                <button class="btn btn-primary disabled">
                    No te sigue
                </button>
            {% endif %}

            <button class="btn btn-success btn-follow {{ app.user | is_following(user) ? 'd-none' : '' }}" data-followed="{{user.id}}">
                <i class="bi bi-person-plus"></i>
                Seguir
            </button>
            <button class="btn btn-outline-danger btn-unfollow {{ app.user | is_following(user) ? '' : 'd-none' }}" data-followed="{{user.id}}">
                <i class="bi bi-person-dash"></i>
                Dejar de seguir
            </button>

        </div>

    
    {% endif %}

        <h2> {{ user.name }} {{ user.surname }} </h2>
        <div class="clearfix"></div>
        <span class="nickname-profile">
            {{ user.nick }}
        </span>

    </div>
    
    <div class="bio">
        {{ user.bio }}
    </div>

    {% set user_stats = user | user_stats %}
    <div id="user_stats">
        <div class="following-data">
            <a href="{{ path('following_users', { nickname: user.nick }) }}">
                <span class="label-stat">
                    Siguiendo
                </span>
                <span class="number-stat">
                    {{ user_stats.following }}
                </span>
            </a>
        </div>

        <div class="following-data">
            <a href="{{ path('followed_users', { nickname: user.nick }) }}">
                <span class="label-stat">
                    Seguidores
                </span>
                <span class="number-stat">
                    {{ user_stats.followers }}
                </span>
            </a>
        </div>

        <div class="following-data">
            <a href="{{ path('user_profile', { nickname: user.nick }) }}">
                <span class="label-stat">
                    Publicaciones
                </span>
                <span class="number-stat">
                    {{ user_stats.publications }}
                </span>
            </a>
        </div>

        <div class="following-data">
            <a href="{{ path('user_likes', { nickname: user.nick }) }}">
                <span class="label-stat">
                    Me gustas
                </span>
                <span class="number-stat">
                    {{ user_stats.likes }}
                </span>
            </a>
        </div>
    </div>
    
    <div id="user-publication">
        {% for publication in pagination %}
            <div class="publication-item d-flex col-lg-12  gap-2 mb-3">
                <div class="avatar">
                    {% if publication.user.image is not null and publication.user.image is not empty %}
                        <img src="/uploads/users/{{ publication.user.image }}" alt="Avatar de {{ publication.user.name|default(publication.user.email) }}">
                    {% else %}
                        <img class="default" src="/uploads/users/default-avatar.jpg" alt="Avatar por defecto">
                    {% endif %}
                </div>

                <div class="flex-grow-1">
                    <!-- Nombre, nick y fecha -->
                    <div class="d-flex align-items-baseline publication-item-content gap-2">
                        <p class="mb-0">
                            <a class="pub-name-link" href="{{ path('user_profile', { nickname: publication.user.nick }) }}">
                                {{ publication.user.name }}
                                {{ publication.user.surname }}
                            </a>
                        </p>
                        -
                        <span class="pub-name-nick">{{ publication.user.nick }}</span>

                        <!-- Fecha  -->
                        <span class="pub-date text-muted ms-auto">
                            {{ publication.createdAt | time_diff() }}
                        </span>
                    </div>


                    <!-- Biografía  -->
                    <div class="mt-2 flex-grow-1">
                        <p class="publication-text">
                            {{ publication.text }}
                        </p>

                        <!-- Boton ELIMINAR -->
                        {% if publication.user.id is defined and publication.user.id == app.user.id %}
                            <span data-id={{ publication.id }} aria-hidden="true" class="btn btn-delete-pub icon" target="_blank" title="Eliminar">
                                <i class="bi bi-trash fs-5"></i>
                            </span>
                        {% endif %}

                        <!-- Boton DOC -->
                        {% if publication.document is not null and publication.document is not empty %}
                            <a href="{{ asset('uploads/publications/documents/' ~ publication.document) }}" class="btn icon btn-doc" target="_blank" title="Descargar documento PDF">
                                <i class="bi bi-file-earmark-pdf fs-5"></i>
                            </a>
                        {% endif %}

                        <!-- Boton IMG -->
                        {% if publication.image is not null and publication.image is not empty %}
                            <span aria-hidden="true" class="btn btn-image icon" target="_blank" title="Descargar imagen">
                                <i class="bi bi-image-fill fs-5"></i>
                            </span>

                            <div class="pub-image">
                                <img src="{{ asset('uploads/publications/images/' ~ publication.image) }}"/>
                            </div>

                        {% endif %}


                        <!-- Botón Me Gusta -->
                        <div class="like d-flex justify-content-end mt-2">
                            <span data-id="{{publication.id}}" class="btn btn-like icon-like {{ app.user | liked(publication) ? 'd-none' : '' }}" data-toggle="tooltip" data-placement="bottom" title="Me gusta">
                                <i class="bi bi-heart"></i>
                            </span>

                            <span data-id="{{publication.id}}" class="active btn btn-unlike icon-unlike {{ app.user | liked(publication) ? '' : 'd-none' }}" data-toggle="tooltip" data-placement="bottom" title="Ya no me gusta">
                                <i class="bi bi-heart-fill"></i>
                            </span>
                        </div>

                    </div>
                </div>

                <hr/>
                <div class="clearfix"></div>
            </div>
        {% endfor %}

        <!-- Barra de cargando (spinner) -->
        <div class="loading-spinner text-center my-4" style="display: none;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-2">Cargando más publicaciones...</p>
        </div>

        <div class="navigation">
            {{ knp_pagination_render(pagination) }}
        </div>
        
    </div>
</div>

{% endblock %}
