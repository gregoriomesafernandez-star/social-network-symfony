{% extends 'layout/layout.html.twig' %}   

{% block title %}Editar datos{% endblock %}

{% block content %}

    <div class="container mb-5">
        <div class="row justify-content-center">
            <div class="col-md-7">
                <div class="card shadow">
                    <div class="card-body p-5">
                        <h2 class="text-center mb-4">Mis datos<hr/></h2>
                        

                        {{ form_start(form, {'enctype': 'multipart/form-data'}) }}
                        
                           <div class="mb-3">
                              {{ form_row(form.name) }}
                           </div>

                           <div class="mb-3">
                              {{ form_row(form.surname) }}
                           </div>

                           <div class="mb-3">
                              {{ form_row(form.nick) }}
                           </div>

                           <div class="mb-3">
                              {{ form_row(form.email) }}
                           </div>

                           <div class="mb-3">
                              {{ form_row(form.bio) }}
                           </div>

                           <div class="mb-4">
                              {{ form_row(form.image) }}
                           </div>

                           <button type="submit" class="btn btn-primary w-100 py-3">
                              Guardar
                           </button>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>

    

{% endblock %}